# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.venv/
venv/
.mypy_cache/
.coverage

# Env / secrets — NEVER commit real credentials
.env
.env.*
!.env.example

# Node / web
web/node_modules/
web/dist/
web/package-lock.json

# React frontend (Vite) — build output covered by dist/ above; keep the
# lockfile committed for reproducible `npm ci` in CI.
frontend/node_modules/
frontend/dist/
frontend/coverage/

# Playwright e2e outputs (the HTML report is archived as a CI artifact instead).
frontend/test-results/
frontend/playwright-report/
frontend/playwright/.cache/

# Generated demo output
out/
sample-data/generated/
*.mp4
!sample-data/**/*.md
# Keep the committed demo video + its build work dir stays ignored
!demo/cinemory-demo.mp4
demo/.video-build/
# Keep the committed screen capture of the live app that the demo video is cut
# from (demo/capture-live.py writes the raw take to demo/.capture/, which stays
# ignored; only the trimmed per-beat clips are committed).
!demo/video-assets/footage/*.mp4
demo/.capture*/

# Firebase Hosting deploy cache
.firebase/

# Readiness gate output (regenerated each run; archived as a CI artifact)
readiness.json

# OS / editor
.DS_Store
.idea/
.vscode/

# PII SAFETY: never commit real personal media or the private cinemory content
# The public repo uses GENERATED demo memories only (see src/cinemory/synthetic.py
# and sample-data/README.md).
*.jpg
*.jpeg
*.heic
private/
real-memories/
# The one deliberate exception: the committed AI-generated anniversary scene
# photos used as the demo video's input. Fictional, model-generated people; no
# real person's photograph. See sample-data/README.md.
!sample-data/anniversary/*.jpg
